{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:feed && npm run build:layouts && vite build",
    "build:client": "vite build --config vite.client.config.ts",
    "build:layouts": "vite build --config vite.layouts.config.ts",
    "build:settings": "vite build --config vite.settings.config.ts",
    "preview": "wrangler pages dev dist --d1=webapp-production --local",
    "deploy": "npm run build && wrangler pages deploy dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply webapp-production",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build:feed": "vite build --config vite.feed.config.ts"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.110.0"
  }
}
